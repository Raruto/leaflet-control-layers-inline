{
  "name": "leaflet-control-layers-inline",
  "version": "0.1.0",
  "description": "A Leaflet plugin that allows to display inline layers control",
  "main": "leaflet-control-layers-inline.js",
  "scripts": {
    "build": "esbuild leaflet-control-layers-inline.js --minify --outfile=leaflet-control-layers-inline.min.js",
    "test": "npm run build && cucumber-js",
    "preversion": "node build/version.js",
    "version": "npm run build && git add -A",
    "postversion": "npm publish --access public && git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raruto/leaflet-control-layers-inline.git"
  },
  "keywords": [
    "leaflet",
    "control",
    "layers",
    "inline"
  ],
  "author": "Raruto",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Raruto/leaflet-control-layers-inline/issues"
  },
  "homepage": "https://github.com/Raruto/leaflet-control-layers-inline#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4 || ^2.0.0-beta.3"
  }
}
